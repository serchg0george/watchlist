{
  "name": "watchlist",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.sw.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.react-test.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js && vitest run",
    "validate-data": "tsc -p tsconfig.test.json && node .test-build/tools/validate-data.js data/movies.json"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
